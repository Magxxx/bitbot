# Never commit real private keys.
EVM_PRIVATE_KEY=0xYOUR_32_BYTE_SOURCE_PRIVATE_KEY

# base or ethereum
SOURCE_CHAIN=base

# Amount the recipient should receive on Arc, with up to 6 decimals.
# This public example intentionally caps one transfer at 500 USDC.
AMOUNT_USDC=5

# Optional. Defaults to the source signer address.
DESTINATION_ADDRESS=0xYOUR_ARC_RECIPIENT

# Optional. A funded Arc account can relay gatewayMint for a recipient that has
# no Arc gas. If omitted, EVM_PRIVATE_KEY is also used as the Arc relayer.
ARC_RELAYER_PRIVATE_KEY=0xOPTIONAL_FUNDED_ARC_RELAYER_PRIVATE_KEY

# true: deposit any missing USDC into Gateway and wait for finality.
# false: spend only an already-finalized Gateway balance.
AUTO_DEPOSIT=true

# A stable, unique name makes an interrupted run resumable.
OPERATION_ID=my-first-arc-transfer
